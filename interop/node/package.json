{
  "name": "@arcships/rutis-interop",
  "version": "0.3.0",
  "description": "Node runtime and binding generator of rutis-interop: mount Cordis plugins in rutis applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcships/rutis.git",
    "directory": "interop/node"
  },
  "homepage": "https://github.com/arcships/rutis/tree/main/crates/rutis-interop#readme",
  "rutisProtocol": 2,
  "rutisChannels": [
    "unix",
    "fd"
  ],
  "type": "module",
  "exports": {
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./bridge": "./src/bridge/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "ws": "^8.22.0"
  }
}
