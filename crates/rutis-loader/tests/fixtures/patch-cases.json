[
  {"name": "insert then replace config",
   "layers": [[{"insert": [{"id": "a", "name": "pa", "config": {"x": 1, "y": 2}}]}],
              [{"id": "a", "config": {"x": 3}}]]},
  {"name": "name assertion mismatch skips the patch",
   "layers": [[{"insert": [{"id": "a", "name": "pa"}]}, {"id": "a", "name": "other", "disabled": true}, {"id": "a", "name": "pa", "config": 1}]]},
  {"name": "missing targets and missing id warn",
   "layers": [[{"id": "nope", "disabled": true}, {"disabled": true}, {"insert": [{"id": "x", "name": "px"}], "id": "nope"}]]},
  {"name": "insert into a group and into a non-group",
   "layers": [[{"insert": [{"id": "g", "name": "grp", "group": true, "config": [{"id": "c1", "name": "p1"}]}, {"id": "leaf", "name": "pl"}]}],
              [{"insert": [{"id": "c2", "name": "p2"}], "id": "g"}, {"insert": [{"id": "c3", "name": "p3"}], "id": "leaf"}, {"id": "c2", "disabled": true}]]},
  {"name": "replaced group children are invisible to later patches",
   "layers": [[{"insert": [{"id": "g", "name": "grp", "group": true, "config": [{"id": "old", "name": "po"}]}]}],
              [{"id": "g", "config": [{"id": "new", "name": "pn"}]}],
              [{"id": "new", "disabled": true}, {"id": "old", "disabled": true}]]},
  {"name": "insert after a whole config replacement mixes raw and indexed rows",
   "layers": [[{"insert": [{"id": "g", "name": "grp", "group": true, "config": []}]}],
              [{"id": "g", "config": [{"id": "raw", "name": "pr"}]}],
              [{"insert": [{"id": "added", "name": "pad"}], "id": "g"}, {"id": "added", "config": {"k": true}}, {"id": "raw", "disabled": true}]]},
  {"name": "empty insert and empty id insert go to the root",
   "layers": [[{"insert": []}, {"id": "", "insert": [{"id": "r", "name": "pr"}]}]]},
  {"name": "null override is written as null",
   "layers": [[{"insert": [{"id": "a", "name": "pa", "disabled": true, "config": {"x": 1}}]}, {"id": "a", "disabled": null, "config": null}]]},
  {"name": "nested groups",
   "layers": [[{"insert": [{"id": "outer", "name": "go", "group": true, "config": [{"id": "inner", "name": "gi", "group": true, "config": [{"id": "deep", "name": "pd"}]}]}]}],
              [{"insert": [{"id": "deep2", "name": "pd2"}], "id": "inner"}, {"id": "deep", "config": {"v": 2}}]]},
  {"name": "duplicate ids: the later row takes the index",
   "layers": [[{"insert": [{"id": "d", "name": "first"}, {"id": "d", "name": "second"}]}, {"id": "d", "disabled": true}]]},
  {"name": "override can turn a row into a group",
   "layers": [[{"insert": [{"id": "a", "name": "pa", "config": [{"id": "c", "name": "pc"}]}]}, {"id": "a", "group": true}, {"insert": [{"id": "c2", "name": "pc2"}], "id": "a"}, {"id": "c", "disabled": true}]]}
]
